# Токен бота от @BotFather (обязателен в проде)
BOT_TOKEN=

# Публичный HTTPS-адрес, по которому доступно это приложение.
# Нужен для кнопки «Открыть» в боте; тот же адрес укажите в BotFather.
WEBAPP_URL=

PORT=3000
DB_PATH=./data/app.db

# Как часто перепроверять цену каждого товара, минут
CHECK_INTERVAL_MIN=60
# Минимальное падение цены (в %), о котором стоит уведомлять, если цель не задана
MIN_DROP_PERCENT=3
# Лимит товаров на пользователя
MAX_ITEMS_PER_USER=50

# Ozon режет запросы без «человеческих» cookie и с IP дата-центров.
# Сюда можно положить строку Cookie из браузера (после прохождения антибота).
OZON_COOKIE=
# Прокси для запросов к Ozon: задайте HTTPS_PROXY и NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port
# NODE_USE_ENV_PROXY=1

# --- только для локальной разработки ---
# Фейковые цены вместо реального Ozon
OZON_MOCK=
# Пускать в API без проверки подписи Telegram под этим user id. НИКОГДА не включать в проде.
DEV_USER_ID=
