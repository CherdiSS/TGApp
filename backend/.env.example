# Токен от @BotFather
BOT_TOKEN=123456789:AA...

# Куда приходят заказы: ваш user_id или id группы сотрудников (у групп он отрицательный).
# Узнать: напишите боту /id
OWNER_CHAT_ID=

# Кому доступна админка меню (через запятую)
ADMIN_IDS=

# HTTPS-адрес фронтенда (Vercel/Netlify или туннель). Кнопка «Меню» в боте ведёт сюда.
WEBAPP_URL=https://your-app.vercel.app

# Разрешённые origin'ы фронтенда. Для прода укажите точный адрес.
CORS_ORIGINS=*

DB_PATH=data/cafe.db

# Только для локальной разработки: открыть приложение в браузере без Telegram.
DEV_MODE=0
